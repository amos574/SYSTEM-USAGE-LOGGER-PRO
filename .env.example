# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / PUBLIC_APP_URL: The public URL where this applet is hosted in production.
# Used for public email dashboard links, OAuth callbacks, and self-referential links.
# In development/preview mode, if left unset, email links will safely adapt without sending broken links.
APP_URL=""
PUBLIC_APP_URL=""

# Optional SMTP Settings for Email Delivery
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="syslogger-pro@app.internal"
